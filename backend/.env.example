# Backend Environment Configuration Template
# For local development and benchmarking, always default to the local PostgreSQL instance (port 5433).
# Do NOT point DATABASE_URL to production Supabase during local benchmarking, testing, or cache building.

# Database (Local Postgres with pgvector via Docker Compose on port 5433)
DATABASE_URL=postgresql://rizal:rizalpass123@localhost:5433/rizal_db

# Production Database (Supabase Singapore Pooler - for deployment only, DO NOT use for local dev)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Redis (optional for local dev; in-process LRU memory caches used by default)
REDIS_URL=redis://localhost:6379

# Machine Learning Models
BERT_MODEL_NAME=sentence-transformers/paraphrase-xlm-r-multilingual-v1
DAPT_MODEL_NAME=mematello/rizal-xlm-r-dapt

# Environment & Debugging Flags
ENVIRONMENT=development
DEBUG=false
TEST_GATE_THRESHOLD_OOV=0.45
